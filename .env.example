# Deployment environment variables for Coolify
# These are built into the Docker image at build time via Next.js public env vars,
# but also used at runtime by the Express server (server.js).

# IAM authentication base URL
IAM_BASE_URL=https://id.item.com

# WMS API base URL
WMS_API_BASE_URL=https://unis.item.com/api

# Next.js public variants (used during static build)
NEXT_PUBLIC_IAM_BASE_URL=https://id.item.com
NEXT_PUBLIC_WMS_API_BASE_URL=https://unis.item.com/api

# Port (default 3000)
PORT=3000
